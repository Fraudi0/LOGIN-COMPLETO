# Copie este arquivo para .env e preencha com os seus dados.
# O arquivo .env esta no .gitignore e nao vai para o repositorio.

# String de conexao do MongoDB Atlas.
# Pegue em Clusters > Connect > Drivers no painel do Atlas.
# Troque USUARIO e SENHA pelos dados do usuario criado em Database Access.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Nome do banco de dados. O Atlas cria sozinho na primeira gravacao.
MONGODB_DATABASE=login_seguro

# Administrador criado automaticamente na primeira execucao.
# Troque a senha antes de usar em qualquer ambiente real.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=Admin@12345

# Tema visual carregado. Opcoes prontas: padrao, escuro.
APP_TEMA=padrao
